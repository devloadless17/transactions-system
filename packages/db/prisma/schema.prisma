// =================================================================
// Transactions System — Prisma Schema
//
// Multi-tenant fintech-style transaction platform.
// All money fields use Decimal(20, 8). All timestamps are UTC.
// Tenant-scoped tables carry company_id and are protected by RLS
// policies declared in migration 0002_rls.sql.
// =================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums -----------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN_OPERATOR
  BACKOFFICE
  COMPANY_OWNER
  COMPANY_MANAGER
  COMPANY_VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SourceStatus {
  ACTIVE
  INACTIVE
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

// Which deposit product of a source a SourceFeeRule applies to. INGEST = a direct
// ingest-API deposit; WHISH_PAY = a deposit settled from a Whish collect link
// (a whish_payments row references the transaction).
enum SourceFeeChannel {
  INGEST
  WHISH_PAY
}

enum FeeOperationType {
  TRANSACTION
  WITHDRAWAL
  PAYOUT
  LOAD
}

enum FeeApplication {
  DEDUCTED
  ON_TOP
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  REFUNDED
}

enum LedgerAccountType {
  AVAILABLE
  PENDING
  RESERVED
  FEE
  EXTERNAL
  // Debt owed by the company to the platform (e.g. the uncovered remainder of a
  // reversal after available was drained). No wallet projection — like FEE/EXTERNAL.
  RECEIVABLE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PayoutMethod {
  BANK_TRANSFER
  CRYPTO
  CASH
  WISH
  OTHER
}

enum WhishPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

// ----------------------------- Users -----------------------------

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique @db.Citext
  passwordHash        String     @map("password_hash")
  role                UserRole
  status              UserStatus @default(ACTIVE)
  companyId           String?    @map("company_id") @db.Uuid
  company             Company?   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens        RefreshToken[]
  approvedWithdrawals  Withdrawal[]   @relation("WithdrawalApprovedBy")
  requestedWithdrawals Withdrawal[]   @relation("WithdrawalRequestedBy")
  approvedPayouts      Payout[]       @relation("PayoutApprovedBy")
  requestedPayouts     Payout[]       @relation("PayoutRequestedBy")
  approvedLoads        Load[]         @relation("LoadApprovedBy")
  requestedLoads       Load[]         @relation("LoadRequestedBy")
  cancelledWithdrawals Withdrawal[]   @relation("WithdrawalCancelledBy")
  cancelledPayouts     Payout[]       @relation("PayoutCancelledBy")
  cancelledLoads       Load[]         @relation("LoadCancelledBy")
  auditLogs            AuditLog[]

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  // Set ONLY when this token was revoked by benign ROTATION (a refresh minted a
  // successor). A token revoked by a security action (logout / password change /
  // admin reset / reuse-detection) leaves this null. The refresh() grace window
  // re-issues only for recently-rotated tokens, so a deliberately-killed session
  // can never be resurrected within the grace window.
  rotatedAt  DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// --------------------------- Companies ---------------------------

model Company {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  slug            String        @unique
  status          CompanyStatus @default(ACTIVE)
  // When false, the company is hidden from discovery/list APIs (e.g. the
  // source-facing GET /v1/ingest/companies). Toggled by SUPER_ADMIN.
  visible         Boolean       @default(true)
  defaultCurrency String        @map("default_currency") @db.Char(3)
  metadata        Json?         @db.JsonB
  // Optional outbound webhook: where to POST payment events (e.g. whish.payment.paid),
  // and the secret used to HMAC-sign the body. Configured by the company.
  webhookUrl      String?       @map("webhook_url")
  webhookSecret   String?       @map("webhook_secret")
  // Per-company default redirect URLs for Whish collect links: where the PAYER is
  // sent after a successful / failed payment. NULL → the platform's /pay pages.
  // A create-payment request may override these per link. (Only the customer-facing
  // redirect; the settlement callback URLs stay platform-controlled.)
  whishSuccessRedirectUrl String? @map("whish_success_redirect_url")
  whishFailureRedirectUrl String? @map("whish_failure_redirect_url")
  // Per-company CRM integration: we POST each transaction's status lifecycle
  // (pending → completed, failed/expired, reversed) to the company's own CRM
  // endpoint, authenticating with their API key in the Authorization header.
  // The crmDemo* pair backs the built-in live "mock CRM" preview.
  crmApiUrl       String?       @map("crm_api_url")
  crmApiKey       String?       @map("crm_api_key")
  crmEnabled      Boolean       @default(false) @map("crm_enabled")
  crmDemoToken    String?       @unique @map("crm_demo_token")
  crmDemoKey      String?       @map("crm_demo_key")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  users             User[]
  apiKeys           ApiKey[]
  commissionRules   CommissionRule[]
  transactions      Transaction[]
  wallets           Wallet[]
  ledgerEntries     LedgerEntry[]
  withdrawals       Withdrawal[]
  payouts           Payout[]
  loads             Load[]
  auditLogs         AuditLog[]
  whishPayments     WhishPayment[]
  companySources    CompanySource[]
  webhookDeliveries WebhookDelivery[]
  crmDemoEvents     CrmDemoEvent[]

  @@index([status])
  @@map("companies")
}

// --------------------------- Sources -----------------------------

model Source {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  code      String       @unique
  status    SourceStatus @default(ACTIVE)
  metadata  Json?        @db.JsonB
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  commissionRules CommissionRule[]
  transactions    Transaction[]
  apiKeys         ApiKey[]
  companySources  CompanySource[]
  feeRules        SourceFeeRule[]

  @@map("sources")
}

// What an upstream source charges THE PLATFORM on each incoming deposit — the
// inverse of CommissionRule (which is what the platform charges its companies).
// Used only to compute the platform's net revenue (platform revenue − source
// fees); never exposed to companies. Tiered like commission rules: an amount
// band per channel carrying a FIXED amount or a PERCENTAGE rate. Global/admin
// config (no company_id, not under RLS) — same posture as Source.
model SourceFeeRule {
  id        String           @id @default(uuid()) @db.Uuid
  sourceId  String           @map("source_id") @db.Uuid
  source    Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  channel   SourceFeeChannel @default(INGEST)
  minAmount Decimal          @default(0) @map("min_amount") @db.Decimal(20, 8)
  maxAmount Decimal?         @map("max_amount") @db.Decimal(20, 8)
  feeType   CommissionType   @map("fee_type")
  feeValue  Decimal          @map("fee_value") @db.Decimal(20, 8)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sourceId, channel, active])
  @@map("source_fee_rules")
}

// ----------------------- Company ↔ Source pairing -----------------
// Sources are system-wide: any ACTIVE + visible company may ingest from any
// ACTIVE source. This table is an OPTIONAL admin record/convenience, NOT an
// ingest authorization gate — TransactionsService.ingest gates only on
// source.status, company.status and company.visible, and never reads this table.
model CompanySource {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceId  String   @map("source_id") @db.Uuid
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, sourceId])
  @@index([sourceId, enabled])
  @@map("company_sources")
}

// --------------------------- API Keys ----------------------------

// API keys come in two flavours:
//   - SOURCE keys (sourceId set, companyId null): held by external providers
//     like OMT/wish. Caller posts to /v1/ingest/transactions with a
//     `companySlug` in the body. Can target any ACTIVE + visible company
//     (sources are system-wide; see CompanySource above).
//   - COMPANY keys (companyId set, sourceId null): legacy company-held keys.
//     The company picks `sourceCode` per request.
// Exactly one of `companyId` / `sourceId` is set — enforced by CHECK.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String?   @map("company_id") @db.Uuid
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceId   String?   @map("source_id") @db.Uuid
  source     Source?   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @map("key_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([keyPrefix])
  @@index([companyId])
  @@index([sourceId])
  @@map("api_keys")
}

// ----------------------- Commission Rules ------------------------

model CommissionRule {
  id              String           @id @default(uuid()) @db.Uuid
  // A single UI "rule" (a set of companies × operations × amount tiers) is stored
  // as MANY of these rows sharing one groupId, so the hot-path resolver/index stay
  // unchanged. Nullable for legacy/seed rows; backfilled to `id` (each its own
  // group) by migration 20260618120000.
  groupId         String?          @map("group_id") @db.Uuid
  // Optional admin-facing label for the whole rule (shared across the group's
  // rows), e.g. "Standard fees" or "VIP partners". Display only.
  name            String?
  companyId       String?          @map("company_id") @db.Uuid
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceId        String?          @map("source_id") @db.Uuid
  source          Source?          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  operationType   FeeOperationType @default(TRANSACTION) @map("operation_type")
  feeApplication  FeeApplication   @default(DEDUCTED) @map("fee_application")
  minAmount       Decimal          @map("min_amount") @db.Decimal(20, 8)
  // NULL = "and above" — an open-ended top tier with no upper bound. The resolver
  // treats a null max as +infinity (amount always within range from above).
  maxAmount       Decimal?         @map("max_amount") @db.Decimal(20, 8)
  commissionType  CommissionType   @map("commission_type")
  commissionValue Decimal          @map("commission_value") @db.Decimal(20, 8)
  priority        Int              @default(0)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, sourceId, operationType, active, priority])
  @@index([groupId])
  @@map("commission_rules")
}

// --------------------------- Transactions ------------------------

model Transaction {
  id                    String            @id @default(uuid()) @db.Uuid
  companyId             String            @map("company_id") @db.Uuid
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceId              String            @map("source_id") @db.Uuid
  source                Source            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalTransactionId String            @map("external_transaction_id")
  amount                Decimal           @db.Decimal(20, 8)
  currency              String            @db.Char(3)
  commissionAmount      Decimal           @map("commission_amount") @db.Decimal(20, 8)
  netAmount             Decimal           @map("net_amount") @db.Decimal(20, 8)
  // What the upstream source charged THE PLATFORM on this deposit (cost of funds),
  // frozen at settlement from the source's fee schedule. Net revenue =
  // Σ commission_amount (FEE ledger) − Σ source_fee_amount. Admin/system-only;
  // never exposed to companies. Not a ledger account — a recorded cost estimate.
  sourceFeeAmount       Decimal           @default(0) @map("source_fee_amount") @db.Decimal(20, 8)
  status                TransactionStatus @default(PENDING)
  payload               Json              @db.JsonB
  idempotencyKey        String?           @map("idempotency_key")
  processedAt           DateTime?         @map("processed_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledgerEntries LedgerEntry[]
  whishPayment  WhishPayment?

  @@unique([sourceId, externalTransactionId])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
  @@index([companyId, status])
  // Admin cross-company list (default view, all statuses) orders by created_at
  // desc with no company filter — (company_id, created_at) can't serve that.
  // Mirrors the standalone created_at index the sibling money tables already have.
  @@index([createdAt])
  // Company list filtered by status AND ordered by created_at, and the
  // company-scoped COMPLETED volume/daily KPI: (company_id, status) finds the rows
  // but can't avoid the sort — this composite serves filter + sort + limit (and
  // the analytics aggregate) from one index.
  @@index([companyId, status, createdAt], map: "transactions_company_status_created_idx")
  // Trigram GIN index backing the admin `externalTransactionId contains …` search.
  // A btree can't serve an unanchored substring LIKE. Declared here (not just in raw
  // SQL) so `prisma migrate dev` tracks it and never drift-drops it again. Requires
  // the pg_trgm extension, created in the migration that adds this index.
  @@index([externalTransactionId(ops: raw("gin_trgm_ops"))], type: Gin, map: "transactions_external_id_trgm_idx")
  // Partial index "transactions_completed_created_idx" (created_at DESC, id DESC)
  // WHERE status='COMPLETED' backs the unified activity feed; not expressible in
  // Prisma, lives in migration 20260622180000_activity_completed_created_indexes.
  @@map("transactions")
}

// ----------------------------- Wallets ---------------------------

model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currency         String   @db.Char(3)
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(20, 8)
  pendingBalance   Decimal  @default(0) @map("pending_balance") @db.Decimal(20, 8)
  reservedBalance  Decimal  @default(0) @map("reserved_balance") @db.Decimal(20, 8)
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, currency])
  @@map("wallets")
}

// --------------------------- Ledger ------------------------------
// Append-only. No UPDATE/DELETE allowed (enforced by DB trigger).

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transactionId String?           @map("transaction_id") @db.Uuid
  transaction   Transaction?      @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  withdrawalId  String?           @map("withdrawal_id") @db.Uuid
  withdrawal    Withdrawal?       @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  payoutId      String?           @map("payout_id") @db.Uuid
  payout        Payout?           @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  loadId        String?           @map("load_id") @db.Uuid
  load          Load?             @relation(fields: [loadId], references: [id], onDelete: Restrict)
  accountType   LedgerAccountType @map("account_type")
  direction     LedgerDirection
  amount        Decimal           @db.Decimal(20, 8)
  currency      String            @db.Char(3)
  metadata      Json?             @db.JsonB
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, currency, createdAt])
  // Powers the windowed reconciliation sweep (groupBy where createdAt > since),
  // which runs cross-tenant and so can't use the company-leading composite above.
  @@index([createdAt])
  @@index([transactionId])
  @@index([withdrawalId])
  @@index([payoutId])
  @@index([loadId])
  @@map("ledger_entries")
}

// -------------------------- Withdrawals / Payouts / Loads --------
// Three sibling tables with the same shape. They were one table with a
// `kind` column up to migration 0008; 0009 split them so each has its
// own page, endpoint, service, and lifecycle.
//   - Withdrawal: company pays an external third party (out)
//   - Payout:     company pays itself                       (out)
//   - Load:       company tops up its own wallet            (in)

model Withdrawal {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  amount            Decimal          @db.Decimal(20, 8)
  currency          String           @db.Char(3)
  feeAmount         Decimal          @default(0) @map("fee_amount") @db.Decimal(20, 8)
  netAmount         Decimal          @default(0) @map("net_amount") @db.Decimal(20, 8)
  feeApplication    FeeApplication   @default(DEDUCTED) @map("fee_application")
  status            WithdrawalStatus @default(PENDING)
  payoutMethod      PayoutMethod     @map("payout_method")
  payoutDetails     Json?            @map("payout_details") @db.JsonB
  externalReference String?          @map("external_reference")
  requestedById     String?          @map("requested_by_id") @db.Uuid
  requestedBy       User?            @relation("WithdrawalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById      String?          @map("approved_by_id") @db.Uuid
  approvedBy        User?            @relation("WithdrawalApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledById     String?          @map("cancelled_by_id") @db.Uuid
  cancelledBy       User?            @relation("WithdrawalCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  notes             String?
  adminNotes        String?          @map("admin_notes")
  metadata          Json?            @db.JsonB
  processedAt       DateTime?        @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledgerEntries LedgerEntry[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  // Admin cross-company list orders by created_at desc with no company filter,
  // which (company_id, created_at) can't serve (mirrors transaction_logs_created_at_idx).
  @@index([createdAt])
  // Partial index "withdrawals_completed_created_idx" (created_at DESC, id DESC)
  // WHERE status='COMPLETED' backs the unified activity feed; raw SQL in
  // migration 20260622180000_activity_completed_created_indexes.
  @@map("withdrawals")
}

model Payout {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  amount            Decimal          @db.Decimal(20, 8)
  currency          String           @db.Char(3)
  feeAmount         Decimal          @default(0) @map("fee_amount") @db.Decimal(20, 8)
  netAmount         Decimal          @default(0) @map("net_amount") @db.Decimal(20, 8)
  feeApplication    FeeApplication   @default(DEDUCTED) @map("fee_application")
  status            WithdrawalStatus @default(PENDING)
  payoutMethod      PayoutMethod     @map("payout_method")
  payoutDetails     Json?            @map("payout_details") @db.JsonB
  externalReference String?          @map("external_reference")
  requestedById     String?          @map("requested_by_id") @db.Uuid
  requestedBy       User?            @relation("PayoutRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById      String?          @map("approved_by_id") @db.Uuid
  approvedBy        User?            @relation("PayoutApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledById     String?          @map("cancelled_by_id") @db.Uuid
  cancelledBy       User?            @relation("PayoutCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  notes             String?
  adminNotes        String?          @map("admin_notes")
  metadata          Json?            @db.JsonB
  processedAt       DateTime?        @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledgerEntries LedgerEntry[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  // Admin cross-company list orders by created_at desc with no company filter.
  @@index([createdAt])
  // Partial index "payouts_completed_created_idx" (created_at DESC, id DESC)
  // WHERE status='COMPLETED' backs the unified activity feed; raw SQL in
  // migration 20260622180000_activity_completed_created_indexes.
  @@map("payouts")
}

model Load {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  amount            Decimal          @db.Decimal(20, 8)
  currency          String           @db.Char(3)
  feeAmount         Decimal          @default(0) @map("fee_amount") @db.Decimal(20, 8)
  netAmount         Decimal          @default(0) @map("net_amount") @db.Decimal(20, 8)
  feeApplication    FeeApplication   @default(DEDUCTED) @map("fee_application")
  status            WithdrawalStatus @default(PENDING)
  payoutMethod      PayoutMethod     @map("payout_method")
  payoutDetails     Json?            @map("payout_details") @db.JsonB
  externalReference String?          @map("external_reference")
  requestedById     String?          @map("requested_by_id") @db.Uuid
  requestedBy       User?            @relation("LoadRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById      String?          @map("approved_by_id") @db.Uuid
  approvedBy        User?            @relation("LoadApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledById     String?          @map("cancelled_by_id") @db.Uuid
  cancelledBy       User?            @relation("LoadCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  notes             String?
  adminNotes        String?          @map("admin_notes")
  metadata          Json?            @db.JsonB
  processedAt       DateTime?        @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledgerEntries LedgerEntry[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  // Admin cross-company list orders by created_at desc with no company filter.
  @@index([createdAt])
  // Partial index "loads_completed_created_idx" (created_at DESC, id DESC)
  // WHERE status='COMPLETED' backs the unified activity feed; raw SQL in
  // migration 20260622180000_activity_completed_created_indexes.
  @@map("loads")
}

// -------------------------- Audit Logs ---------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  // Restrict (not SetNull): audit_logs is append-only (DB trigger rejects
  // UPDATE), so a SetNull-on-delete would fail. Entities with audit history are
  // disabled, never hard-deleted.
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  companyId  String?  @map("company_id") @db.Uuid
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  // Covers the default (unfiltered) admin audit list, ordered by (created_at DESC,
  // id DESC) — without this, that view seq-scans + external-sorts the whole table
  // at scale. A backward index scan early-stops on LIMIT instead.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "audit_logs_created_at_id_idx")
  @@map("audit_logs")
}

// -------------------------- Whish Payments -----------------------
// A payment link minted on behalf of a company via Whish Pay. We are the
// third party calling Whish (outbound). `externalId` is the numeric
// reference we send to Whish and which it echoes back on the callback +
// status lookups; it doubles as the `external_transaction_id` of the
// ledger Transaction written once the payment is confirmed PAID, giving
// idempotent settlement for free. Tenant-scoped (RLS by company_id).

model WhishPayment {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  externalId       BigInt             @unique @default(autoincrement()) @map("external_id")
  callbackToken    String             @unique @map("callback_token")
  amount           Decimal            @db.Decimal(20, 8)
  currency         String             @db.Char(3)
  invoice          String
  status           WhishPaymentStatus @default(PENDING)
  collectUrl       String?            @map("collect_url")
  payerPhoneNumber String?            @map("payer_phone_number")
  transactionId    String?            @unique @map("transaction_id") @db.Uuid
  transaction      Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  idempotencyKey   String?            @map("idempotency_key")
  metadata         Json?              @db.JsonB
  paidAt           DateTime?          @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  // Admin cross-company Whish list orders by created_at desc, unfiltered.
  @@index([createdAt])
  @@map("whish_payments")
}

// ----------------------- Whish W2W transfers --------------------
// Outbound whish-to-whish transfers sent from the platform's Whish account to a
// recipient phone, via Whish's CONSUMER mobile-app API (POST application/submit)
// — a different surface from the merchant collect API the WhishPayment model
// uses. Admin-driven now (a SUPER_ADMIN "Transfer Money" tool); the same path
// will later auto-fire on withdrawal approval (hence the nullable company/
// withdrawal linkage). Whish returns NO transfer id (only an X-Trace-Id header),
// so `reference` is OUR idempotency key — we also send it upstream as the `note`
// so a Whish-app transaction can be tied back to a row here. Platform-level, so
// admin-only RLS (like transaction_logs), not tenant-scoped.
//   PENDING — row committed, upstream call not yet resolved
//   SUCCESS — Whish answered status:true (money moved)
//   FAILED  — definite business/validation/auth failure (money did NOT move)
//   UNKNOWN — network/timeout/5xx: money MAY have moved; needs operator reconcile
enum WhishTransferStatus {
  PENDING
  SUCCESS
  FAILED
  UNKNOWN
}

model WhishTransfer {
  id              String              @id @default(uuid()) @db.Uuid
  // Our idempotency key; also sent upstream as the Whish `note` (fieldId 140).
  reference       String              @unique
  recipientPhone  String              @map("recipient_phone")
  amount          Decimal             @db.Decimal(20, 8)
  currency        String              @default("USD") @db.Char(3)
  status          WhishTransferStatus @default(PENDING)
  // X-Trace-Id response header — the only upstream correlation id we get.
  traceId         String?             @map("trace_id")
  // The sessionCounter consumed by this attempt (forensics / replay debugging).
  sessionCounter  Int?                @map("session_counter")
  upstreamCode    String?             @map("upstream_code")
  upstreamMessage String?             @map("upstream_message")
  // Request/response bodies for the admin detail drawer. Session headers/creds
  // are REDACTED before persisting — never store token/uid/sessionid here.
  requestBody     Json?               @map("request_body") @db.JsonB
  responseBody    Json?               @map("response_body") @db.JsonB
  // SUPER_ADMIN who triggered it; null when fired by the withdrawal flow/system.
  actorId         String?             @map("actor_id") @db.Uuid
  source          String              @default("ADMIN")
  // Set only when triggered by a withdrawal (future auto-transfer linkage).
  companyId       String?             @map("company_id") @db.Uuid
  withdrawalId    String?             @unique @map("withdrawal_id") @db.Uuid
  errorDetail     String?             @map("error_detail")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([recipientPhone, createdAt])
  // Default admin list orders by created_at desc, unfiltered.
  @@index([createdAt])
  @@map("whish_transfers")
}

// Single-row store for the captured Whish consumer-app SESSION used to sign W2W
// transfers. These creds (token/uid/sessionid/deviceId/serverid) are a logged-in
// mobile-app session and EXPIRE often, so they're editable from the SUPER_ADMIN
// UI (no redeploy) rather than living in env. The secret fields are encrypted at
// rest (AES-256-GCM, key from WHISH_W2W_ENC_KEY). `sessionCounter` is the
// monotonic per-request counter Whish expects; it's incremented atomically
// (UPDATE ... RETURNING) so concurrent sends never reuse a value. Admin-only RLS.
model WhishSessionCredential {
  id                String    @id @default("default")
  encToken          String    @map("enc_token")
  encUid            String    @map("enc_uid")
  encSessionId      String    @map("enc_session_id")
  deviceId          String    @map("device_id")
  serverId          String    @map("server_id")
  itelVersion       String    @map("itel_version")
  osVersion         String    @map("os_version")
  operatingSystem   String    @map("operating_system")
  userAgent         String    @map("user_agent")
  sessionCounter    Int       @default(0) @map("session_counter")
  lastRotatedAt     DateTime? @map("last_rotated_at") @db.Timestamptz(6)
  lastAuthFailureAt DateTime? @map("last_auth_failure_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("whish_session_credentials")
}

// Single-row config for auto-approving Whish (WISH) withdrawals: on request, the
// background processor transfers the money via W2W and settles the withdrawal —
// no human step. Ships OFF (`enabled` false): nothing auto-processes until a
// SUPER_ADMIN flips it on, and then only for requests created after `enabledAt`.
// `holdSeconds` is the cancel/safety window; `maxAutoApproveAmount` caps the auto
// amount. The circuit breaker (`circuitBreakerTrippedAt` + `consecutiveFailures`)
// auto-pauses on Whish failure, independent of `enabled` so a trip keeps the
// operator's preference. Admin-only RLS.
model WithdrawalAutoApprovalConfig {
  id                      String    @id @default("default")
  enabled                 Boolean   @default(false)
  enabledAt               DateTime? @map("enabled_at") @db.Timestamptz(6)
  holdSeconds             Int       @default(30) @map("hold_seconds")
  maxAutoApproveAmount    Decimal   @default(500) @map("max_auto_approve_amount") @db.Decimal(20, 8)
  circuitBreakerTrippedAt DateTime? @map("circuit_breaker_tripped_at") @db.Timestamptz(6)
  consecutiveFailures     Int       @default(0) @map("consecutive_failures")
  failureThreshold        Int       @default(3) @map("failure_threshold")
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("withdrawal_auto_approval_configs")
}

// -------------------------- Webhook Deliveries -------------------
// Durable log/queue of outbound webhook attempts. Created in 0001 and protected
// by RLS (0002). NOTE: not yet wired — the current Whish webhook delivery is
// fire-and-forget (see WhishWebhookService); this model exists so schema.prisma
// matches the live DB (no drift / destructive migrate) and is ready to adopt
// for durable, retried delivery. Tenant-scoped (RLS by company_id).
model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventType      String                @map("event_type")
  payload        Json                  @db.JsonB
  targetUrl      String                @map("target_url")
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body")
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?             @map("last_attempt_at") @db.Timestamptz(6)
  nextRetryAt    DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

// ------------------------- CRM demo inbox ------------------------
// Backs the built-in "mock CRM" preview: a live feed of the exact events we
// POST to a company's CRM. One row per logical transaction, upserted by
// `reference` so the same record visibly transitions PENDING → COMPLETED (and
// FAILED/EXPIRED/REVERSED). Tenant-scoped (RLS by company_id). Pruned to the
// most recent rows per company by the writer.
model CrmDemoEvent {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference  String
  eventType  String   @map("event_type")
  status     String
  payload    Json     @db.JsonB
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([companyId, reference])
  @@index([companyId, receivedAt])
  @@map("crm_demo_events")
}

// --------------------- Transaction logs (admin) ------------------
// Request/response audit for the two transaction entry points, for the super
// admin to inspect what came in and what we answered:
//   WHISH_LINK — every Whish payment-link generation (the request we sent to
//                Whish + Whish's response, success or failure).
//   INGEST     — every source ingest call (the request body + the response we
//                returned, including rejected/4xx attempts).
// Admin-only: the RLS policy allows ONLY app.bypass_rls (i.e. runAsAdmin), so
// no tenant can read these. `company_id` is denormalised (no FK) so a log row
// stands on its own. Append-only in practice (we never update/delete a row).
enum TransactionLogKind {
  WHISH_LINK
  INGEST
  WHISH_TRANSFER
}

model TransactionLog {
  id            String             @id @default(uuid()) @db.Uuid
  kind          TransactionLogKind
  companyId     String?            @map("company_id") @db.Uuid
  sourceCode    String?            @map("source_code")
  reference     String?
  transactionId String?            @map("transaction_id") @db.Uuid
  statusCode    Int                @map("status_code")
  success       Boolean
  request       Json?              @db.JsonB
  response      Json?              @db.JsonB
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([kind, createdAt])
  // The default admin Logs view passes no `kind`, so the composite above can't
  // serve its `order by createdAt desc`. This standalone index does.
  @@index([createdAt])
  @@map("transaction_logs")
}

// --------------------------- Notifications -----------------------
// In-app notifications powering the topbar bell. ADMIN-scope rows (a new
// withdrawal/payout/load request) are visible only to platform admins and are
// stored with company_id = NULL so RLS can never expose them to a tenant; the
// subject company is kept in `metadata` for display. COMPANY-scope rows (a
// request approved/rejected/completed/cancelled) belong to one company and are
// RLS-isolated by company_id. Read state is per-user via NotificationRead.
// scope/flow/event are TEXT (validated by the shared zod enums), matching the
// CRM table's string-column convention.
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String // NotificationScope: ADMIN | COMPANY
  companyId String?  @map("company_id") @db.Uuid // RLS tenant; NULL for ADMIN scope
  flow      String // NotificationFlow: WITHDRAWAL | PAYOUT | LOAD
  event     String // NotificationEvent: REQUESTED | APPROVED | REJECTED | COMPLETED | CANCELLED
  title     String
  body      String
  link      String
  entityId  String?  @map("entity_id") @db.Uuid
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reads NotificationRead[]

  @@index([scope, companyId, createdAt])
  @@map("notifications")
}

// Per-user read marker. A notification is "unread" for a user until a row here
// exists for (notificationId, userId). company_id is denormalised for RLS so a
// tenant only ever sees its own read markers.
model NotificationRead {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at") @db.Timestamptz(6)
  // Per-user "clear": when set, the notification is hidden from the active list
  // but kept under the "Cleared" filter for review.
  dismissedAt    DateTime?    @map("dismissed_at") @db.Timestamptz(6)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}
