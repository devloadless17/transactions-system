        {
          "name": "Recent withdrawals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/company/withdrawals",
              "host": ["{{baseUrl}}"],
              "path": ["company", "withdrawals"]
            }
          }
        },
        {
          "name": "Company analytics overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/company/analytics/overview?currency=USD",
              "host": ["{{baseUrl}}"],
              "path": ["company", "analytics", "overview"],
              "query": [{ "key": "currency", "value": "USD" }]
            }
          }
        }
      ]
    },
    {
      "name": "05 — Withdrawals",
      "item": [
        {
          "name": "Request CRYPTO withdrawal (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const j = pm.response.json().data; // responses are enveloped: { success, statusCode, data }",
                  "pm.collectionVariables.set('withdrawalId', j.id);",
                  "pm.test('Status is PENDING', () => pm.expect(j.status).to.equal('PENDING'));",
                  "pm.test('Payout method captured', () => pm.expect(j.payoutMethod).to.equal('CRYPTO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"50\",\n  \"currency\": \"USD\",\n  \"notes\": \"postman crypto test\",\n  \"payout\": {\n    \"method\": \"CRYPTO\",\n    \"network\": \"TRC20\",\n    \"walletAddress\": \"TX9zABCDefg-example-tron-address\",\n    \"memo\": \"postman-demo\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/company/withdrawals",
              "host": ["{{baseUrl}}"],
              "path": ["company", "withdrawals"]
            },
            "description": "Run **02 — Login as company owner** first so the cookie is the owner's.\n\nMoves 50 USD from `available` to `reserved`. Status PENDING until admin approves."
          }
        },
        {
          "name": "Request BANK withdrawal (owner)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"30\",\n  \"currency\": \"USD\",\n  \"payout\": {\n    \"method\": \"BANK_TRANSFER\",\n    \"accountHolder\": \"My Test Co Ltd\",\n    \"accountNumber\": \"LB12-0000-0000-0000\",\n    \"bankName\": \"BLOM Bank\",\n    \"swiftBic\": \"BLOMLBBX\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/company/withdrawals",
              "host": ["{{baseUrl}}"],
              "path": ["company", "withdrawals"]
            }
          }
        },
        {
          "name": "Request CASH withdrawal (owner)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"20\",\n  \"currency\": \"USD\",\n  \"payout\": {\n    \"method\": \"CASH\",\n    \"recipientName\": \"Ali\",\n    \"recipientPhone\": \"+961-3-123-456\",\n    \"pickupLocation\": \"OMT Beirut branch\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/company/withdrawals",
              "host": ["{{baseUrl}}"],
              "path": ["company", "withdrawals"]
            }
          }
        },
        {
          "name": "(switch to admin) Login as super admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.cookies.get('csrf-token');",
                  "if (c) pm.collectionVariables.set('csrfToken', c);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Switches the active session back to admin so the next approve/reject calls authenticate as admin."
          }
        },
        {
          "name": "Admin: list pending withdrawals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/withdrawals?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "withdrawals"],
              "query": [{ "key": "status", "value": "PENDING" }]
            }
          }
        },
        {
          "name": "Admin: approve with externalReference",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalReference\": \"WIRE-REF-2026-001\",\n  \"notes\": \"sent via cold wallet at 10:30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "withdrawals", "{{withdrawalId}}", "approve"]
            },
            "description": "Approves the most-recently-created withdrawal (auto-captured into {{withdrawalId}}).\n\n**Required**: `externalReference` (≥2 chars). This represents the off-platform proof — bank wire id, crypto tx hash, receipt number — that the admin **already sent the money**. The platform doesn't move the money; it records the accounting around that movement."
          }
        },
        {
          "name": "Admin: reject (alternative path)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"KYC mismatch — please update bank details\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "withdrawals", "{{withdrawalId}}", "reject"]
            },
            "description": "Use instead of approve. Funds return from reserved → available."
          }
        }
      ]
    },
