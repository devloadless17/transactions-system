# ============================================================================
# Production environment template.
#
# The deploy workflow copies this to the server as `.env` and replaces every
# __PLACEHOLDER__ with the matching GitHub secret. Do NOT put real values here.
#
# Passwords that end up inside a connection URL (POSTGRES_PASSWORD,
# POSTGRES_PASSWORD_RLS) MUST be URL-safe — use alphanumeric only, e.g.
#   openssl rand -hex 24
# The other secrets (JWT_*, CSRF_SECRET, METRICS_TOKEN) can be any >=32-char
# string, e.g.  openssl rand -base64 36
# ============================================================================

# ---- Container images (Docker Hub) ----
DOCKER_USERNAME=__DOCKER_USERNAME__
IMAGE_TAG=latest

# ---- Public domain (single domain; web + API share it) ----
DOMAIN=__DOMAIN__

# ---- Database (Postgres) ----
POSTGRES_USER=txn_app
POSTGRES_DB=txn_system
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
# Runtime RLS role (non-superuser). The deploy rotates its password to this.
POSTGRES_USER_RLS=txn_app_rls
POSTGRES_PASSWORD_RLS=__POSTGRES_PASSWORD_RLS__

# ---- API secrets (each must be >=32 chars; all three must differ) ----
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
CSRF_SECRET=__CSRF_SECRET__
# Gates GET /metrics (kept internal; not exposed by Caddy). Required in prod.
METRICS_TOKEN=__METRICS_TOKEN__

# ---- Derived public URLs (single-domain, path-based; computed from DOMAIN) ----
COOKIE_DOMAIN=__DOMAIN__
WEB_ORIGIN=https://__DOMAIN__
ALLOWED_ORIGINS=https://__DOMAIN__
API_PUBLIC_URL=https://__DOMAIN__/v1

# ---- Initial super admin (used only when SEED_DATABASE=true) ----
SEED_ADMIN_EMAIL=__SEED_ADMIN_EMAIL__
SEED_ADMIN_PASSWORD=__SEED_ADMIN_PASSWORD__
# Set to true ONLY for the very first deploy (workflow_dispatch input). The
# workflow overwrites this line; leave it false here.
SEED_DATABASE=false

# ---- Whish Pay (optional) ----
# Leave WHISH_CHANNEL / WHISH_SECRET blank if you are not using Whish; the API
# boots fine with Whish "not configured". When set, these production values are
# required (the API refuses sandbox/localhost in prod unless WHISH_ALLOW_SANDBOX).
#
# WHISH_BASE_URL / WHISH_WEBSITE_URL are secret-driven so you can run the sandbox
# now and switch to live later by changing GitHub secrets only:
#   - sandbox: WHISH_BASE_URL=https://api.sandbox.whish.money/itel-service/api
#              WHISH_WEBSITE_URL=<your sandbox-registered host, e.g. rival.com>
#              WHISH_ALLOW_SANDBOX=true
#   - live:    WHISH_BASE_URL=https://api.whish.money/itel-service/api
#              WHISH_WEBSITE_URL=https://<your registered domain>
#              WHISH_ALLOW_SANDBOX=false  (or unset)
# When the secret is unset, the deploy falls back to the live defaults.
WHISH_BASE_URL=__WHISH_BASE_URL__
WHISH_CHANNEL=__WHISH_CHANNEL__
WHISH_SECRET=__WHISH_SECRET__
WHISH_WEBSITE_URL=__WHISH_WEBSITE_URL__
WHISH_CALLBACK_BASE=https://__DOMAIN__/v1
WHISH_USER_AGENT=Whish/1.0 (https://whish.money; support@whish.money)
WHISH_ENABLED_CURRENCIES=USD
# Set true ONLY while testing the Whish sandbox against production; false for live.
WHISH_ALLOW_SANDBOX=__WHISH_ALLOW_SANDBOX__
