{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API for the transactions system",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@app/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.1",
    "@nestjs/common": "11.0.0",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.0.0",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.0.0",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/swagger": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "^11.1.24",
    "@willsoto/nestjs-prometheus": "6.0.2",
    "argon2": "0.41.1",
    "bullmq": "5.34.5",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "nanoid": "3.3.8",
    "nestjs-pino": "4.2.0",
    "nestjs-zod": "4.3.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "pino-pretty": "13.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "5.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.0",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "24.0.0",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
