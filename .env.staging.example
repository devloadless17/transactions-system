# ============================================================================
# STAGING environment — copy to `.env.staging` ON THE SERVER and fill real
# values. This is NOT rendered by the deploy workflow (prod owns `.env`); you
# maintain `.env.staging` by hand. Keep it chmod 600.
#
# Staging runs the SAME images as prod but with its own DB, its own secrets and
# the Whish SANDBOX. Generate FRESH secrets — do NOT reuse the prod ones:
#   POSTGRES_PASSWORD / POSTGRES_PASSWORD_RLS : openssl rand -hex 24  (URL-safe!)
#   JWT_ACCESS_SECRET / JWT_REFRESH_SECRET / CSRF_SECRET / METRICS_TOKEN:
#                                               openssl rand -base64 36
# JWT_ACCESS_SECRET, JWT_REFRESH_SECRET and CSRF_SECRET must all DIFFER.
# ============================================================================

# ---- Container images (reuse the prod images) ----
DOCKER_USERNAME=alialahmad
# Pin to a known-good commit SHA tag for reproducibility (recommended), or use
# `latest`. e.g. IMAGE_TAG=93c5de9eceee8c0a4c99e5cb4d877a0340677077
IMAGE_TAG=latest

# ---- Database (separate instance + volume from prod) ----
POSTGRES_USER=txn_app
POSTGRES_DB=txn_system
POSTGRES_PASSWORD=__FILL_staging_db_password__
POSTGRES_USER_RLS=txn_app_rls
POSTGRES_PASSWORD_RLS=__FILL_staging_db_rls_password__

# ---- API secrets (each >=32 chars; all three must differ; NOT the prod ones) ----
JWT_ACCESS_SECRET=__FILL_staging_jwt_access__
JWT_REFRESH_SECRET=__FILL_staging_jwt_refresh__
CSRF_SECRET=__FILL_staging_csrf__
METRICS_TOKEN=__FILL_staging_metrics__

# ---- Public URLs (the staging subdomain; single-domain, path-based) ----
# Host-only cookies (no Domain attribute) — leave EMPTY so staging's cookies
# stay on the staging host and never collide with prod's.
COOKIE_DOMAIN=
WEB_ORIGIN=https://staging.portal.rivalpayments.com
ALLOWED_ORIGINS=https://staging.portal.rivalpayments.com
API_PUBLIC_URL=https://staging.portal.rivalpayments.com/v1

# ---- Initial super admin (used only on the first migrate with SEED_DATABASE=true) ----
SEED_ADMIN_EMAIL=ali@loadless.ai
SEED_ADMIN_PASSWORD=__FILL_staging_admin_password__
# Set to true ONLY for the very first staging migrate run, then back to false.
SEED_DATABASE=false

# ---- Whish Pay — SANDBOX (this is the whole point of staging) ----
WHISH_BASE_URL=https://api.sandbox.whish.money/itel-service/api
WHISH_CHANNEL=__FILL_sandbox_channel__
WHISH_SECRET=__FILL_sandbox_secret__
# The host registered with the Whish SANDBOX for these credentials (sandbox
# accepts a bare host, no https required).
WHISH_WEBSITE_URL=staging.portal.rivalpayments.com
WHISH_CALLBACK_BASE=https://staging.portal.rivalpayments.com/v1
WHISH_USER_AGENT=Whish/1.0 (https://whish.money; support@whish.money)
WHISH_ENABLED_CURRENCIES=USD
# Required true so the prod build accepts the sandbox base + non-https website URL.
WHISH_ALLOW_SANDBOX=true
