# Production reverse proxy with automatic HTTPS (Let's Encrypt).
#
# Single domain, path-based:
#   https://DOMAIN/v1/*        → API (NestJS)
#   https://DOMAIN/socket.io/* → API realtime (Socket.IO; WebSocket upgrade auto)
#   https://DOMAIN/*           → web app (Next.js)
#
# Same-origin web ↔ API, so cookies/CORS need no cross-site config. Caddy
# obtains and renews the TLS cert automatically once DNS points DOMAIN at this
# server and ports 80/443 are reachable. DOMAIN is injected from the env.
{$DOMAIN} {
	encode zstd gzip

	# Security headers on every response (defense-in-depth alongside the API's own
	# helmet headers, and covering the Next.js app too). HSTS is safe here because
	# Caddy terminates TLS for this domain.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API: versioned REST + realtime socket. `handle` blocks are mutually
	# exclusive and ordered, so this never shadows the web catch-all below.
	@api path /v1/* /socket.io/*
	handle @api {
		reverse_proxy api:3001
	}

	# Everything else is the web app.
	handle {
		reverse_proxy web:3000
	}
}

# ---------------------------------------------------------------------------
# OPTIONAL staging instance — same app, isolated DB/Redis, Whish SANDBOX.
# Served by THIS Caddy over the shared `edge` network to the staging containers
# (docker-compose.staging.yml: api-staging / web-staging). If the staging stack
# isn't running, this block simply 502s; it never affects the prod site above.
# Caddy auto-provisions a separate TLS cert once a DNS A record for this host
# points at the server. Change the hostname here if you use a different one.
# ---------------------------------------------------------------------------
staging.portal.rivalpayments.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /v1/* /socket.io/*
	handle @api {
		reverse_proxy api-staging:3001
	}

	handle {
		reverse_proxy web-staging:3000
	}
}
