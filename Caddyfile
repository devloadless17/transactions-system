# Production reverse proxy with automatic HTTPS (Let's Encrypt).
#
# Single domain, path-based:
#   https://DOMAIN/v1/*        → API (NestJS)
#   https://DOMAIN/socket.io/* → API realtime (Socket.IO; WebSocket upgrade auto)
#   https://DOMAIN/*           → web app (Next.js)
#
# Same-origin web ↔ API, so cookies/CORS need no cross-site config. Caddy
# obtains and renews the TLS cert automatically once DNS points DOMAIN at this
# server and ports 80/443 are reachable. DOMAIN is injected from the env.
#
# Global options. `email` registers a contact on the Let's Encrypt ACME account,
# which is the SMOKE ALARM for TLS: renewal is fully automatic (Caddy renews at
# ~1/3 of the cert's remaining life, weeks before expiry), but if it ever failed
# repeatedly, Let's Encrypt emails this address before the cert lapses. Without a
# contact the account is anonymous and a silent renewal failure stays silent.
{
	email dev@loadless.ai

	# WHO IS THE VISITOR? Decided HERE, once, for both sites.
	#
	# Cloudflare fronts both sites — prod and staging — so the peer Caddy sees is a
	# CF edge, not the visitor. Undeclared, the API received `X-Forwarded-For: <cloudflare-ip>`
	# with the visitor stripped, so every prod request logged and rate-limited as a
	# CF edge IP (104.22.x / 172.7x.x) — measured 2026-09-10, and the reason the
	# Sept 9 export investigation could not identify a session by IP.
	#
	# The visitor's address is read from `CF-Connecting-IP`, and ONLY when the peer
	# is one of Cloudflare's published ranges (`trusted_proxies` + `client_ip_headers`
	# below). From any other peer the visitor is simply the peer — whatever headers
	# it sent. Each site then hands the API exactly ONE address in X-Forwarded-For
	# (`header_up X-Forwarded-For {client_ip}` in every reverse_proxy), replacing
	# anything the request arrived with.
	#
	# Why CF-Connecting-IP and not the X-Forwarded-For chain: Cloudflare APPENDS to
	# an X-Forwarded-For the caller already sent, so the chain carries caller-chosen
	# text, and walking it past "trusted" hops stops being safe the moment the
	# caller's own address is inside Cloudflare's space — a Cloudflare Worker is.
	# Its forged left-most entry would become the client IP: a fresh rate-limit
	# bucket per request (the login and API-key limits never trip) and a forged IP
	# in the audit trail. CF-Connecting-IP is set by Cloudflare itself on every
	# request and cannot be supplied by the caller (for a Worker it is the Worker's
	# shared address, so Workers share ONE bucket).
	#
	# A caller that reaches this server directly, not through Cloudflare, is not in
	# these ranges, so nothing it sends is believed and it is identified by its peer
	# address. A caller that IS in Cloudflare's space but is not our edge (a Worker
	# fetching the origin directly) cannot set CF-Connecting-IP either.
	#
	# The API in turn trusts only this proxy (apps/api/src/common/http/
	# trusted-proxies.ts) — it never walks a forwarded chain itself.
	# Ranges: https://www.cloudflare.com/ips/ (refresh if Cloudflare adds space; a
	# range missing here is fail-safe — that edge is treated as the visitor).
	servers {
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}

	# The API runs blue/green (below): one colour is normally stopped, so its
	# health check fails every second, by design. Those checks log at INFO, one
	# line a second per stopped colour, forever. Keep them out of the main log;
	# a real health-checker error still shows.
	log default {
		exclude http.handlers.reverse_proxy.health_checker.active
	}
	log health_checks {
		include http.handlers.reverse_proxy.health_checker.active
		level ERROR
	}
}
#
# Zero-loss, zero-wait deploys (blue/green) — this is a money system: a deploy
# must not drop or stall a single request.
#   - The API runs as two containers, blue and green (docker-compose.prod.yml).
#     Each site lists BOTH, plus `api` (the single container they replaced, and
#     a name both colours still answer to). `lb_policy first` sends every
#     request to the first HEALTHY one in that order; a stopped colour simply
#     fails its health check and is skipped.
#   - A release (scripts/deploy/release.sh) starts the new version in the other
#     colour beside the live one, and waits until this Caddy's health check has
#     passed on it (the API remembers checks carrying `health_headers`, and the
#     script asks it). Only then does the old one drain: on SIGTERM it answers
#     503 (apps/api/src/common/http/graceful-drain.ts), Caddy moves to the other
#     colour within a second, and the old one finishes everything in flight —
#     no request is lost and none waits, because a healthy colour is always up.
#   - If no colour is healthy (a first start, or a crash), Caddy HOLDS each
#     request (lb_try_duration) and retries every lb_try_interval. A request held
#     this way never reached a backend, so retrying it runs nothing twice. 60s
#     stays inside Cloudflare's 100s limit.
#
# `header_up X-Forwarded-For {client_ip}` in every reverse_proxy: the upstream is
# told ONE visitor address — the one resolved by the global options above — and
# never a chain a caller could have seeded. See "WHO IS THE VISITOR?".
{$DOMAIN} {
	encode zstd gzip

	# Security headers on every response (defense-in-depth alongside the API's own
	# helmet headers, and covering the Next.js app too). HSTS is safe here because
	# Caddy terminates TLS for this domain.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API: versioned REST + realtime socket. `handle` blocks are mutually
	# exclusive and ordered, so this never shadows the web catch-all below.
	@api path /v1/* /socket.io/*
	handle @api {
		reverse_proxy api-blue:3001 api-green:3001 api:3001 {
			header_up X-Forwarded-For {client_ip}
			lb_policy first
			lb_try_duration 60s
			lb_try_interval 250ms
			health_uri /v1/health
			health_interval 1s
			health_timeout 3s
			health_headers {
				X-Health-Check caddy
			}
		}
	}

	# Everything else is the web app.
	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
			lb_try_duration 60s
			lb_try_interval 250ms
		}
	}
}

# ---------------------------------------------------------------------------
# OPTIONAL staging instance — same app, isolated DB/Redis, Whish SANDBOX.
# Served by THIS Caddy over the shared `edge` network to the staging containers
# (docker-compose.staging.yml: api-staging-blue/-green / web-staging), blue/green
# exactly like prod. If the staging stack
# isn't running, this block simply 502s; it never affects the prod site above.
# Proxied by Cloudflare exactly like the prod domain (same edge, same visitor-IP
# handling). Caddy gets its own Let's Encrypt cert for the origin: Cloudflare
# passes the plain-HTTP challenge through, as for prod. The name must stay a
# FIRST-level subdomain — Cloudflare's Universal SSL covers *.rivalpayments.com
# only, so a deeper name (the first one, staging.portal.rivalpayments.com) cannot
# be proxied.
# ---------------------------------------------------------------------------
staging.rivalpayments.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /v1/* /socket.io/*
	handle @api {
		reverse_proxy api-staging-blue:3001 api-staging-green:3001 api-staging:3001 {
			header_up X-Forwarded-For {client_ip}
			lb_policy first
			lb_try_duration 60s
			lb_try_interval 250ms
			health_uri /v1/health
			health_interval 1s
			health_timeout 3s
			health_headers {
				X-Health-Check caddy
			}
		}
	}

	handle {
		reverse_proxy web-staging:3000 {
			header_up X-Forwarded-For {client_ip}
			lb_try_duration 60s
			lb_try_interval 250ms
		}
	}
}
