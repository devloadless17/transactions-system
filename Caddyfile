# Local full-HTTPS test gateway for the prod-profile images.
#
# Terminates TLS with Caddy's INTERNAL CA (no public ACME) and reverse-proxies
# to the production containers over the compose network. Lets the app run in
# true NODE_ENV=production mode locally (HTTPS + Secure cookies) without a
# public domain or real certificate. NOT for internet-facing use.
#
# Domains use *.localtest.me, which resolves to loopback, so no /etc/hosts edit
# is needed. The auth cookie is issued for the parent domain `localtest.me`, so
# it is shared between the app and api subdomains.

{
	# Internal CA only; never attempt public certificate issuance.
	auto_https disable_redirects
}

# Web app (Next.js standalone)
app.localtest.me {
	tls internal
	reverse_proxy web:3000
}

# API (NestJS) — browser calls this directly; the web SSR path uses the
# internal http://api:3001 address instead.
api.localtest.me {
	tls internal
	reverse_proxy api:3001
}
