# Every .env variant, including the timestamped backups tooling leaves behind:
# `.env` alone does not match `.env.bak-…`, and those hold live Whish and
# database credentials.
.env
.env.bak*
.env.before*
.env.local
.env.*.local

# Postman environments for the Whish APIs: that is where the Whish channel and
# secret get pasted, so they stay on the developer's machine, never in git.
Whish/*.postman_environment.json

# Locally saved review notes (working files, not part of the repo).
docs/reviews/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

