# =========================================================
# Transactions System — environment variables
# Copy to .env and adjust before running docker compose / dev.
#
# ⚠️  PRODUCTION: the passwords/secrets below are DEV-ONLY defaults that are
#     committed to the repo. For a real deployment you MUST set strong, unique
#     values for: POSTGRES_PASSWORD, POSTGRES_PASSWORD_RLS, JWT_ACCESS_SECRET,
#     JWT_REFRESH_SECRET, CSRF_SECRET, METRICS_TOKEN, SEED_ADMIN_PASSWORD — and
#     rotate the txn_app_rls DB role password server-side (ALTER ROLE).
#     The API refuses to boot in production if it detects a default DB password
#     or a missing/insecure secret.
# =========================================================

# ---- Database ----
POSTGRES_USER=txn_app
POSTGRES_PASSWORD=txn_app_dev_password
POSTGRES_DB=txn_system
POSTGRES_HOST=localhost
POSTGRES_PORT=5444

# Migrations connection (superuser — used by `prisma migrate`/seed).
DATABASE_MIGRATIONS_URL=postgresql://txn_app:txn_app_dev_password@localhost:5444/txn_system?schema=public

# Application connection. Uses txn_app_rls (non-superuser) so PostgreSQL
# Row Level Security policies are actually enforced.
DATABASE_URL=postgresql://txn_app_rls:txn_app_rls_dev_password@localhost:5444/txn_system?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6391
REDIS_URL=redis://localhost:6391

# ---- API ----
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=v1

# JWT (ES256). For dev, HS256 secrets are accepted; in prod use keys.
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_xxxxxxxxx
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_xxxxxxxx
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CSRF_SECRET=dev_csrf_secret_change_me_min_32_chars_xxxxxxxxxxx

# CORS
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (per IP)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- Seed (initial super admin) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPassw0rd!

# ---- Web ----
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
API_INTERNAL_BASE_URL=http://localhost:3001/v1

# ---- Whish Pay (single platform account; sandbox by default) ----
# channel + secret are issued by Whish; leave blank until provisioned.
WHISH_BASE_URL=https://partner.api.sbx.whish.money/itel-service/api
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=http://localhost:3000
WHISH_USER_AGENT="Whish/1.0 (https://whish.money; support@whish.money)"
WHISH_CALLBACK_BASE=http://localhost:3001/v1

# Whish currencies that are live. USD only for now; set "USD,LBP" + add LBP
# commission rules to activate LBP.
WHISH_ENABLED_CURRENCIES=USD

# ---- Withdrawal auto-approval (local/dev = simulated, never real money) ----
# Runs the full auto-approval pipeline (admin toggle, hold window, WISH/USD,
# cap, ledger, webhooks) but fabricates the transfer with a `SIMULATED-` ref
# instead of calling Whish W2W. W2W has NO sandbox — a real transfer moves real
# funds from any environment — so this is the only safe way to exercise
# auto-approval outside production. Mutually exclusive with WHISH_W2W_ENABLED:
# the API refuses to boot with both on.
WITHDRAWAL_AUTO_APPROVAL_SIMULATE=true
# Never turn this on locally: it arms REAL whish-to-whish transfers.
WHISH_W2W_ENABLED=false

# ---- Telegram alerts for load/payout requests ----
# Set BOTH to push a message to your admin group when a company requests a load
# or payout (never withdrawals). Leave BOTH blank to disable (the default). Token
# from @BotFather; chat id is the group id (negative, e.g. -100... for supergroups).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
